def _academy_status_counts(cur, table):
    out = {s: 0 for s in ACADEMY_STATUSES}
    try:
        cur.execute("SELECT status, COUNT(*) AS n FROM " + table + " GROUP BY status")
        for r in (cur.fetchall() or []):
            st = r.get("status")
            if st in out:
                out[st] = int(r.get("n") or 0)
    except Exception:
        pass
    return out


