def _academy_extract(source):
    """Run ONE AI extraction over a source dict. Returns (normalized_extraction, summary,
    error). FAIL-OPEN: on any error returns (empty_extraction, '', error_message)."""
    notes = _academy_clip(source.get("raw_notes"), 14000)
    if not notes:
        return _academy_empty_extraction(), "", "No notes/transcript to extract from."
    user = (
        "SOURCE TITLE: %s\nKIND: %s\nMARKET: %s\nSTRATEGY TYPE: %s\n\nRAW NOTES / TRANSCRIPT:\n%s"
        % (
            _academy_clip(source.get("title"), 300),
            _academy_clip(source.get("source_kind"), 40) or "other",
            _academy_clip(source.get("market_type"), 120),
            _academy_clip(source.get("strategy_type"), 120),
            notes,
        )
    )
    content, err = _academy_ai_chat(
        [{"role": "system", "content": _ACADEMY_EXTRACT_PRIMER},
         {"role": "user", "content": user}],
        ACADEMY_EXTRACT_TOKENS,
    )
    if err:
        return _academy_empty_extraction(), "", err
    parsed = _academy_parse_json(content)
    if not isinstance(parsed, dict):
        return _academy_empty_extraction(), "", "The AI did not return valid JSON."
    norm = _academy_normalize_extraction(parsed)
    summary = _academy_clip(parsed.get("summary") or norm.get("core_concept"), 1500)
    return norm, summary, None


def _academy_apply_extraction(sid, source_row):
    """AI-extract + persist into the source row. Returns the refreshed row dict or None."""
    norm, summary, err = _academy_extract(source_row)
    conn = _learning_conn()
    if conn is None:
        return None
    try:
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute(
                "UPDATE academy_sources SET extraction = %s, ai_summary = %s, "
                "extracted_at = now(), last_error = %s, updated_at = now() "
                "WHERE id = %s RETURNING *",
                (_academy_json_param(norm), (summary or None), err, int(sid)),
            )
            row = cur.fetchone()
        return _academy_jsonable(row) if row else None
    except Exception as exc:
        logger.warning("academy extraction persist failed: %s", exc)
        return None
    finally:
        try: conn.close()
        except Exception: pass


