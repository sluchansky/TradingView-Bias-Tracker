# ======================================================================================
# TRADING ACADEMY / AI TRADING LIBRARY  (LEARNING-ONLY — walled off from the money path)
# --------------------------------------------------------------------------------------
# A knowledge system: knowledge sources -> AI extraction -> strategy playbook cards ->
# validation lifecycle -> honest backtest links -> trade-management library + Q&A.
# HARD SAFETY INVARIANT: nothing in this section may touch the gate / scoring /
# auto-execute / broker / sizing / dedupe / live-management path. It only does
# INSERT/SELECT on the academy_* tables (NO DDL) and makes outbound read-only AI calls.
# Wiring an APPROVED strategy into live execution is intentionally OUT OF SCOPE here.
# Owner-only: every route is proxied but kept OUT of dashboard-auth OPEN_PATHS.
# ======================================================================================
ACADEMY_STATUSES        = ("UNTESTED", "BACKTESTING", "PAPER_TESTING", "APPROVED", "REJECTED")
ACADEMY_LIFECYCLES      = ("active", "testing", "archived")
ACADEMY_APPLIES         = ("scalp", "swing", "both")
ACADEMY_SOURCE_KINDS    = ("youtube", "book", "article", "recap", "screenshot", "backtest", "tradezella", "other")
ACADEMY_MODEL           = ASSISTANT_MODEL          # reuse the same Replit AI Integrations model
ACADEMY_EXTRACT_TOKENS  = 1800
ACADEMY_ASK_TOKENS      = 900
ACADEMY_SCHEMA_VERSION  = 1
ACADEMY_TABLES          = ("academy_sources", "academy_strategies", "academy_management_rules", "academy_validation_events")

ACADEMY_DB_READY        = False
_ACADEMY_PROBE_LOCK     = threading.Lock()
_ACADEMY_PROBE_TS       = 0.0
_ACADEMY_PROBE_RETRY_SEC = 30.0


def _check_academy_db_ready():
    """Probe the academy_* tables (NO DDL). FAIL-OPEN: on any failure the flag stays
    False and the feature degrades to 'unavailable' instead of erroring."""
    global ACADEMY_DB_READY
    if not LEARNING_DB_ENABLED:
        return
    conn = _learning_conn()
    if conn is None:
        return
    try:
        with conn.cursor() as cur:
            for t in ACADEMY_TABLES:               # fixed tuple — no user input in the identifier
                cur.execute("SELECT 1 FROM " + t + " LIMIT 1")
                cur.fetchone()
        ACADEMY_DB_READY = True
        logger.info("academy_* tables ready (Trading Academy)")
    except Exception as exc:
        logger.warning("academy tables unavailable (Trading Academy persistence disabled): %s", exc)
    finally:
        try: conn.close()
        except Exception: pass


def _ensure_academy_probe():
    """Lazily run the readiness probe if boot didn't (boot probes live under
    __main__, so a WSGI import would never set the flag). Cheap, idempotent, throttled."""
    global _ACADEMY_PROBE_TS
    if ACADEMY_DB_READY:
        return
    nowm = time.monotonic()
    with _ACADEMY_PROBE_LOCK:
        if ACADEMY_DB_READY:
            return
        if (nowm - _ACADEMY_PROBE_TS) < _ACADEMY_PROBE_RETRY_SEC:
            return
        _ACADEMY_PROBE_TS = nowm
    _check_academy_db_ready()


# ---- small value helpers (defensive; never raise) ------------------------------------
def _academy_clip(s, n=2000):
    if s is None:
        return ""
    if not isinstance(s, str):
        s = str(s)
    s = s.strip()
    return s[:n] if len(s) > n else s


def _academy_clamp_int(v, lo, hi, default=0):
    try:
        iv = int(v)
    except Exception:
        return default
    return max(lo, min(hi, iv))


def _academy_enum(v, allowed, default):
    try:
        s = str(v).strip().lower()
    except Exception:
        return default
    return s if s in allowed else default


def _academy_status(v, default=""):
    """Status enums are UPPERCASE — must NOT be lowercased like the other enums."""
    try:
        s = str(v).strip().upper()
    except Exception:
        return default
    return s if s in ACADEMY_STATUSES else default


def _academy_str_list(v, max_items=12, item_len=400):
    out = []
    if isinstance(v, str):
        v = [p.strip(" -*\t") for p in v.splitlines()]
    if isinstance(v, (list, tuple)):
        for item in v:
            if isinstance(item, dict):
                item = " ".join(str(x) for x in item.values() if x is not None)
            s = _academy_clip(item, item_len)
            if s:
                out.append(s)
            if len(out) >= max_items:
                break
    return out


def _academy_jsonable(row):
    """RealDict row -> JSON-safe dict (datetimes -> ISO). jsonb already comes back as
    dict/list from psycopg2; INT columns are plain ints (no Decimal in this schema)."""
    out = {}
    try:
        items = dict(row).items()
    except Exception:
        return {}
    for k, v in items:
        if isinstance(v, (datetime, date)):
            try: out[k] = v.isoformat()
            except Exception: out[k] = str(v)
        else:
            out[k] = v
    return out


def _academy_json_param(obj):
    try:
        return psycopg2.extras.Json(obj)
    except Exception:
        return None


def _academy_unavailable_resp():
    return jsonify({"ok": False, "error": "The Trading Academy database is not available yet."}), 503


# ---- AI extraction / normalization ---------------------------------------------------
def _academy_ai_chat(messages, max_tokens):
    """One read-only chat completion via the Replit AI Integrations OpenAI proxy.
    Returns (content, error). NEVER touches the money path."""
    base = (os.environ.get("AI_INTEGRATIONS_OPENAI_BASE_URL") or "").strip().rstrip("/")
    key  = (os.environ.get("AI_INTEGRATIONS_OPENAI_API_KEY") or "").strip()
    if not base or not key:
        return None, "The AI service is not configured on this server yet."
    payload = {"model": ACADEMY_MODEL, "messages": messages, "max_completion_tokens": max_tokens}
    try:
        resp = requests.post(
            base + "/chat/completions",
            headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"},
            json=payload,
            timeout=90,
        )
    except Exception as exc:
        logger.warning("academy AI request failed: %s", exc)
        return None, "Could not reach the AI service."
    if resp.status_code != 200:
        logger.warning("academy AI non-200: %s %s", resp.status_code, (resp.text or "")[:300])
        return None, "AI request failed (HTTP %s)." % resp.status_code
    try:
        j = resp.json()
        content = ((j.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
        return content.strip(), None
    except Exception as exc:
        logger.warning("academy AI parse failed: %s", exc)
        return None, "Could not parse the AI response."


def _academy_parse_json(text):
    """Best-effort JSON extraction from a model reply (handles ```json fences and
    surrounding prose). Returns a dict or None."""
    if not text:
        return None
    t = text.strip()
    if t.startswith("```"):
        inner = t[3:]
        if inner[:4].lower() == "json":
            inner = inner[4:]
        if "```" in inner:
            inner = inner.split("```", 1)[0]
        t = inner.strip()
    try:
        obj = json.loads(t)
        return obj if isinstance(obj, dict) else None
    except Exception:
        pass
    try:
        i = text.index("{")
        j = text.rindex("}")
        obj = json.loads(text[i:j + 1])
        return obj if isinstance(obj, dict) else None
    except Exception:
        return None


def _academy_normalize_extraction(raw):
    """Schema-stable contract so the dashboard never breaks on a missing key:
    fixed keys, arrays always present, scalars default to '', enums allowlisted."""
