# ---- VALIDATION LIFECYCLE (shared status setter + audit) -----------------------------
def _academy_set_status(entity_type, table, eid, allow_lifecycle=False):
    """Shared validation-lifecycle transition for sources / strategies / rules. Writes
    an academy_validation_events audit row. LEARNING-ONLY: setting a strategy to
    APPROVED/active records intent — it does NOT wire the strategy into live trading."""
    _ensure_academy_probe()
    if not (ACADEMY_DB_READY and LEARNING_DB_ENABLED):
        return _academy_unavailable_resp()
    if table not in ("academy_sources", "academy_strategies", "academy_management_rules"):
        return jsonify({"ok": False, "error": "Invalid entity."}), 400      # belt-and-suspenders allowlist
    d = request.get_json(silent=True) or {}
    new_status = _academy_status(d.get("status"))
    new_life   = _academy_enum(d.get("lifecycle"), ACADEMY_LIFECYCLES, "") if allow_lifecycle else ""
    reason     = _academy_clip(d.get("reason"), 800)
    if not new_status and not new_life:
        return jsonify({"ok": False, "error": "A new status or lifecycle is required."}), 400
    conn = _learning_conn()
    if conn is None:
        return _academy_unavailable_resp()
    try:
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute("SELECT * FROM " + table + " WHERE id = %s", (eid,))   # table from fixed allowlist
            row = cur.fetchone()
            if not row:
                return jsonify({"ok": False, "error": "Not found."}), 404
            sets, vals = [], []
            old_status = row.get("status")
            if new_status:
                sets.append("status = %s"); vals.append(new_status)
            if new_life:
                sets.append("lifecycle = %s"); vals.append(new_life)
            sets.append("updated_at = now()")
            vals.append(eid)
            cur.execute("UPDATE " + table + " SET " + ", ".join(sets) + " WHERE id = %s RETURNING *", vals)
            updated = cur.fetchone()
            if new_status and new_status != old_status:
                _academy_log_event(cur, entity_type, eid, old_status, new_status, reason)
        return jsonify({"ok": True, "entity": _academy_jsonable(updated)}), 200
    except Exception as exc:
        logger.warning("academy status set failed: %s", exc)
        return jsonify({"ok": False, "error": "Could not update status."}), 500
    finally:
        try: conn.close()
        except Exception: pass


