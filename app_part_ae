                "SELECT id, name, setup_type, applies_to, confidence, status, lifecycle, backtest "
                "FROM academy_strategies WHERE status <> 'REJECTED' "
                "ORDER BY (status = 'APPROVED') DESC, confidence DESC, created_at DESC LIMIT 10"
            )
            best = [_academy_jsonable(r) for r in (cur.fetchall() or [])]
            cur.execute(
                "SELECT 'strategy' AS kind, id, name AS title, status, updated_at "
                "FROM academy_strategies WHERE status = 'REJECTED' "
                "UNION ALL "
                "SELECT 'source' AS kind, id, title, status, updated_at "
                "FROM academy_sources WHERE status = 'REJECTED' "
                "ORDER BY updated_at DESC LIMIT 25"
            )
            rejected = [_academy_jsonable(r) for r in (cur.fetchall() or [])]
        return jsonify({"ok": True, "counts": counts, "best_lessons": best, "rejected": rejected}), 200
    except Exception as exc:
        logger.warning("academy metrics failed: %s", exc)
        return jsonify({"ok": False, "error": "Could not load metrics."}), 500
    finally:
        try: conn.close()
        except Exception: pass


# ---- Q&A (grounded on a stored source / strategy) ------------------------------------
@app.route("/academy/ask", methods=["POST"])
def academy_ask():
    """Owner-only, READ-ONLY library Q&A. Answers 'what did we learn from this', 'what
    strategy does this teach', 'how would this apply to MGC/MNQ', 'what are the exact
    rules', 'has this been tested', 'should this affect live trading and why'. Grounded
    ONLY on the stored source/strategy. NEVER touches the money path."""
    _ensure_academy_probe()
    if not (ACADEMY_DB_READY and LEARNING_DB_ENABLED):
        return _academy_unavailable_resp()
    d = request.get_json(silent=True) or {}
    question = _academy_clip(d.get("question"), 2000)
    if not question:
        return jsonify({"ok": False, "error": "Ask a question first."}), 400
    ctx = {}
    conn = _learning_conn()
    if conn is None:
        return _academy_unavailable_resp()
    try:
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            if str(d.get("source_id")).isdigit():
                cur.execute(
                    "SELECT id, title, author, source_kind, market_type, strategy_type, "
                    "ai_summary, trust_rating, status, extraction FROM academy_sources WHERE id = %s",
                    (int(d["source_id"]),),
                )
                r = cur.fetchone()
                if r:
                    ctx["source"] = _academy_jsonable(r)
            if str(d.get("strategy_id")).isdigit():
                cur.execute("SELECT * FROM academy_strategies WHERE id = %s", (int(d["strategy_id"]),))
                r = cur.fetchone()
                if r:
                    ctx["strategy"] = _academy_jsonable(r)
    except Exception as exc:
        logger.warning("academy ask context failed (non-fatal): %s", exc)
    finally:
        try: conn.close()
        except Exception: pass

    primer = (
        "You are a professional trading mentor answering the owner's questions about a "
        "stored lesson in their private trading library (the bot trades MGC and MNQ "
        "micro futures). Use ONLY the JSON context provided; if the context does not "
        "contain something, say it is not available rather than inventing it.\n"
        "Be concise and practical. When the owner asks whether this should affect live "
        "trading, answer based on the 'status' field and this rule: a lesson may ONLY "
        "influence live auto-trading once it has been extracted into a strategy card, "
        "backtested, paper-tested, manually reviewed and APPROVED, and promoted to "
        "active — and even then the owner must wire it in deliberately. If status is not "
        "APPROVED, the answer is no, and explain which validation steps remain.\n"
        "This is not financial advice."
    )
    snapshot = "LIBRARY CONTEXT (read-only):\n```json\n%s\n```" % (json.dumps(ctx, default=str)[:12000])
    content, err = _academy_ai_chat(
        [{"role": "system", "content": primer},
         {"role": "system", "content": snapshot},
         {"role": "user", "content": question}],
        ACADEMY_ASK_TOKENS,
    )
    if err:
        return jsonify({"ok": False, "error": err}), 200
    if not content:
        return jsonify({"ok": False, "error": "The AI returned an empty answer."}), 200
    return jsonify({"ok": True, "answer": content, "model": ACADEMY_MODEL}), 200


