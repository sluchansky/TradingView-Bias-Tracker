        try:
            opened_dt = datetime.fromisoformat(opened_at) if opened_at else None
        except Exception:
            opened_dt = None
        conf = ctx.get("confidence")
        try:
            conf = int(round(float(conf))) if conf is not None else None
        except Exception:
