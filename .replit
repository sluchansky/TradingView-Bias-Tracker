modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TradingView Webhook Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scalp_golden"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dual_sim"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "breakout_mode"

[[workflows.workflow]]
name = "TradingView Webhook Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "/home/runner/workspace/.pythonlibs/bin/python3 artifacts/tradingview-webhook/app.py"
waitForPort = 8000

[[workflows.workflow]]
name = "parity"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_parity.sh"

[[workflows.workflow]]
name = "scalp_golden"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_scalp_golden.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dual_sim"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_dual_sim.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "breakout_mode"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_breakout_mode.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TRADOVATE_ENV = "demo"
AUTO_TRADE_CONTRACTS = "2"
MAX_RISK_DOLLARS_PER_TRADE = "200"
BROKER_OPPOSITE_SIDE_BUFFER_SEC = "5"
SCALP_MAIN_BRAIN_ADVISORY_ENABLED = "1"
BREAKOUT_MODE_ENABLED = "1"
USER_APPROVED_PREVIEW_ENABLED = "1"
DUAL_MODE_SHADOW_SIM_ENABLED = "1"
DUAL_SIM_TEST_EDGE_MIN = "70"
MANUAL_ORDER_ENABLED = "1"
MARKET_HOLIDAYS_SKIP = "2026-07-03"
FAST_ENTRY_TRIGGER = "1"
THESIS_HYSTERESIS = "1"
THESIS_ENFORCEMENT_MODE = "shadow"
THESIS_DISCORD_ALERTS_ENABLED = "1"
THESIS_DB_PERSISTENCE_ENABLED = "1"
THESIS_EVAL_DB_PERSIST = "1"
DATABENTO_ENABLED = "1"
EXECUTION_MODE = "traderspost"
SCALP_LIVE_SIM_ENABLED = "1"
VOL_INTELLIGENCE_ENABLED = "1"
VOL_INTELLIGENCE_EXECUTION_INFLUENCE = "0"
VOL_INTELLIGENCE_OBSERVE_ONLY = "1"
VOL_INTELLIGENCE_SCORE_INFLUENCE = "0"
ORDER_FLOW_V1_ENABLED = "1"
CENTRAL_GHOST_COORDINATOR_ENABLED = "1"
CENTRAL_GHOST_COORDINATOR_FANOUT_ENABLED = "0"
CENTRAL_GHOST_COORDINATOR_PERSIST_ENABLED = "0"

[userenv.production]
DUAL_TF_ENGINE = "0"
TRAINING_MODE_ENABLED = "1"
TRADING_MODE = "SCALP"
STRUCTURE_REVERSAL_DEMOTE_ENABLED = "1"
DISCORD_LIVE = "1"
DECISION_PIPELINE_V2_ENABLED = "1"
TRAINING_BOOT_STAGE = "4"
LEARNING_GATE_ENABLED = "1"
RIGHT_BRAIN_TRADE_MANAGEMENT_ENABLED = "1"
VISUAL_BRAIN_ENABLED = "true"

[userenv.development]
LEFT_BRAIN_MARKET_INTELLIGENCE_ENABLED = "1"
VISUAL_BRAIN_ENABLED = "true"
