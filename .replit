modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TradingView Webhook Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scalp_golden"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dual_sim"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "breakout_mode"

[[workflows.workflow]]
name = "TradingView Webhook Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "/home/runner/workspace/.pythonlibs/bin/python3 artifacts/tradingview-webhook/app.py"
waitForPort = 8000

[[workflows.workflow]]
name = "parity"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_parity.sh"

[[workflows.workflow]]
name = "scalp_golden"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_scalp_golden.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dual_sim"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_dual_sim.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "breakout_mode"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_breakout_mode.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 24319
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TRADOVATE_ENV = "demo"
AUTO_TRADE_CONTRACTS = "2"
MAX_RISK_DOLLARS_PER_TRADE = "100"
BROKER_OPPOSITE_SIDE_BUFFER_SEC = "5"
SCALP_MAIN_BRAIN_ADVISORY_ENABLED = "1"
BREAKOUT_MODE_ENABLED = "1"
USER_APPROVED_PREVIEW_ENABLED = "1"
DUAL_MODE_SHADOW_SIM_ENABLED = "1"
DUAL_SIM_TEST_EDGE_MIN = "80"

[userenv.production]
DUAL_TF_ENGINE = "0"
TRAINING_MODE_ENABLED = "0"
TRADING_MODE = "SWING"
