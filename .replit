modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TradingView Webhook Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pycompile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scalp_golden"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "swing_flagoff"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "instrument_isolation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fvg_ob"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cross_market"

[[workflows.workflow]]
name = "TradingView Webhook Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "/home/runner/workspace/.pythonlibs/bin/python3 artifacts/tradingview-webhook/app.py"
waitForPort = 8000

[[workflows.workflow]]
name = "pycompile"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "/home/runner/workspace/.pythonlibs/bin/python3 -m py_compile artifacts/tradingview-webhook/app.py && echo PYCOMPILE_OK"

[[workflows.workflow]]
name = "parity"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_parity.sh"

[[workflows.workflow]]
name = "scalp_golden"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_scalp_golden.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "swing_flagoff"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_swing_flagoff_golden.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "instrument_isolation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_instrument_isolation.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "fvg_ob"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_fvg_ob.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cross_market"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .local/state/check_cross_market.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 24319
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TRADOVATE_ENV = "demo"
AUTO_TRADE_CONTRACTS = "2"
MAX_RISK_DOLLARS_PER_TRADE = "100"
BROKER_OPPOSITE_SIDE_BUFFER_SEC = "5"

[userenv.production]
DUAL_TF_ENGINE = "0"
