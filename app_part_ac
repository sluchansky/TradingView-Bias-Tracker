        for idx, row in enumerate(result.get("table", []), start=1):
            w.writerow([
                idx,
                labels.get("strategy", {}).get(row.get("strategy"), row.get("strategy")),
                labels.get("mgmt", {}).get(row.get("mgmt"), row.get("mgmt")),
                row.get("score"),
