// MNQ Scalp Bot Approximation - Pine Script v5
// Mirrors the live bot SCALP gate logic for MNQ (Micro Nasdaq)
// Use on MNQ1! 1-minute chart. Set timezone to America/New_York.
//@version=5
strategy("MNQ Scalp Bot Approximation", "MNQ-SCALP", overlay=true, currency=currency.USD, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.50, slippage=2)

// === INPUTS ===
i_edge_min    = input.int(60,    "Min edge score (60=EARLY, 70=READY)", minval=0,   maxval=110, group="Signal")
i_pivot_len   = input.int(10,    "Pivot lookback bars",                 minval=3,   maxval=50,  group="Signal")
i_rvol_thresh = input.float(1.5, "RVOL threshold",                     minval=0.5, step=0.1,   group="Signal")
i_cvd_len     = input.int(20,    "CVD baseline length",                 minval=5,   maxval=200, group="Signal")
i_atr_len     = input.int(14,    "ATR length",                         minval=1,               group="Risk")
i_atr_mult    = input.float(2.5, "ATR stop multiplier",                minval=0.5, step=0.5,   group="Risk")
i_stop_floor  = input.float(12,  "Minimum stop (points)",              minval=0.0,             group="Risk")
i_rr          = input.float(1.0, "Take-profit R:R",                    minval=0.25,step=0.25,  group="Risk")
i_max_day     = input.int(3,     "Max entries per day",                 minval=1,   maxval=10,  group="Risk")
i_show_score  = input.bool(true, "Show edge-score labels",                                      group="Display")
i_show_struct = input.bool(true, "Highlight BOS/CHOCH bars",                                    group="Display")
i_show_pivots = input.bool(false,"Show pivot dots",                                             group="Display")

// === VWAP ===
vwap_val = ta.vwap(hlc3)

// === ATR ===
atr = ta.atr(i_atr_len)

// === VOLUME / RVOL ===
vol_avg  = ta.sma(volume, 20)
rvol     = volume / math.max(vol_avg, 1)
vol_conf = rvol >= i_rvol_thresh

// === CVD PROXY ===
delta_bar = close > open ? volume : close < open ? -volume : 0
cvd_raw   = ta.cum(delta_bar)
cvd_base  = ta.sma(cvd_raw, i_cvd_len)
cvd_bull  = cvd_raw > cvd_base
cvd_bear  = cvd_raw < cvd_base

// === MARKET STRUCTURE ===
ph = ta.pivothigh(high, i_pivot_len, i_pivot_len)
pl = ta.pivotlow(low, i_pivot_len, i_pivot_len)

var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na

if not na(ph)
    ph2 := ph1
    ph1 := ph

if not na(pl)
    pl2 := pl1
    pl1 := pl

hh = not na(ph1) and not na(ph2) and ph1 > ph2
lh = not na(ph1) and not na(ph2) and ph1 < ph2
hl = not na(pl1) and not na(pl2) and pl1 > pl2
ll = not na(pl1) and not na(pl2) and pl1 < pl2

bos_long  = not na(ph1) and close > ph1 and close[1] <= ph1
bos_short = not na(pl1) and close < pl1 and close[1] >= pl1

choch_long  = (lh or ll) and bos_long
choch_short = (hh or hl) and bos_short

struct_long  = bos_long  or choch_long  or hh or hl
struct_short = bos_short or choch_short or lh or ll

// === LIQUIDITY SWEEP ===
sweep_bull = not na(pl1) and low  < pl1 and close > pl1
sweep_bear = not na(ph1) and high > ph1 and close < ph1

// === SESSION BONUS ===
hhmm       = hour * 100 + minute
in_session = (hhmm >= 500 and hhmm < 800) or (hhmm >= 800 and hhmm < 1100) or (hhmm >= 2000 and hhmm < 2300)

// === EDGE SCORE ===
// LONG
s_l_bos   = bos_long   ? 20 : 0
s_l_choch = choch_long ? 20 : 0
s_l_vwap  = close > vwap_val ? 15 : 0
s_l_sweep = sweep_bull ? 15 : 0
s_l_vol   = vol_conf   ? 15 : 0
s_l_cvd   = cvd_bull   ? 15 : 0
s_l_sess  = in_session ? 10 : 0
score_long = s_l_bos + s_l_choch + s_l_vwap + s_l_sweep + s_l_vol + s_l_cvd + s_l_sess

// SHORT
s_s_bos   = bos_short   ? 20 : 0
s_s_choch = choch_short ? 20 : 0
s_s_vwap  = close < vwap_val ? 15 : 0
s_s_sweep = sweep_bear  ? 15 : 0
s_s_vol   = vol_conf    ? 15 : 0
s_s_cvd   = cvd_bear    ? 15 : 0
s_s_sess  = in_session  ? 10 : 0
score_short = s_s_bos + s_s_choch + s_s_vwap + s_s_sweep + s_s_vol + s_s_cvd + s_s_sess

// === SIGNALS ===
sig_long  = close > vwap_val and struct_long  and score_long  >= i_edge_min and score_long  > score_short
sig_short = close < vwap_val and struct_short and score_short >= i_edge_min and score_short > score_long

// === DAILY CAP ===
var int trades_today = 0
if ta.change(dayofmonth) != 0
    trades_today := 0
cap_hit = trades_today >= i_max_day

// === STOP / TARGET ===
stop_dist = math.max(atr * i_atr_mult, i_stop_floor)
sl_long   = close - stop_dist
tp_long   = close + stop_dist * i_rr
sl_short  = close + stop_dist
tp_short  = close - stop_dist * i_rr

// === ENTRIES ===
if sig_long and strategy.position_size == 0 and not cap_hit
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", "Long", stop=sl_long, limit=tp_long)
    trades_today := trades_today + 1

if sig_short and strategy.position_size == 0 and not cap_hit
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", "Short", stop=sl_short, limit=tp_short)
    trades_today := trades_today + 1

// === VISUALS ===
plot(vwap_val, "VWAP", color=#38bdf8, linewidth=2)

plotshape(i_show_pivots and not na(ph), "Pivot High", shape.circle, location.abovebar, color.new(color.orange, 50), size=size.tiny)
plotshape(i_show_pivots and not na(pl), "Pivot Low",  shape.circle, location.belowbar, color.new(color.aqua,   50), size=size.tiny)

bgcolor(i_show_struct and choch_long  ? color.new(color.teal,   88) : na, title="CHOCH Bull")
bgcolor(i_show_struct and choch_short ? color.new(color.purple, 88) : na, title="CHOCH Bear")
bgcolor(i_show_struct and bos_long  and not choch_long  ? color.new(color.lime, 94) : na, title="BOS Long")
bgcolor(i_show_struct and bos_short and not choch_short ? color.new(color.red,  94) : na, title="BOS Short")

entry_long_viz  = sig_long  and strategy.position_size == 0 and not cap_hit
entry_short_viz = sig_short and strategy.position_size == 0 and not cap_hit

plotshape(entry_long_viz,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.normal)
plotshape(entry_short_viz, "SELL", shape.triangledown, location.abovebar, color.new(color.red,  0), size=size.normal)

if i_show_score
    if entry_long_viz
        lbl = (score_long >= 70 ? "READY" : "EARLY") + "  " + str.tostring(score_long) + "/110\n" + (s_l_bos > 0 ? "BOS " : "") + (s_l_choch > 0 ? "CHOCH " : "") + (s_l_sweep > 0 ? "SWEEP " : "") + (s_l_cvd > 0 ? "CVD " : "") + (s_l_vol > 0 ? "VOL " : "")
        label.new(bar_index, low - atr * 1.5, lbl, color=color.new(color.black, 60), textcolor=score_long >= 70 ? color.lime : color.yellow, style=label.style_label_up, size=size.small)
    if entry_short_viz
        lbl = (score_short >= 70 ? "READY" : "EARLY") + "  " + str.tostring(score_short) + "/110\n" + (s_s_bos > 0 ? "BOS " : "") + (s_s_choch > 0 ? "CHOCH " : "") + (s_s_sweep > 0 ? "SWEEP " : "") + (s_s_cvd > 0 ? "CVD " : "") + (s_s_vol > 0 ? "VOL " : "")
        label.new(bar_index, high + atr * 1.5, lbl, color=color.new(color.black, 60), textcolor=score_short >= 70 ? color.lime : color.yellow, style=label.style_label_down, size=size.small)
