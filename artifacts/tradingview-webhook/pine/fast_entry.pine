//@version=5
// ───────────────────────────────────────────────────────────────────────────
// Fast Entry Trigger -> Webhook  (MGC / MNQ / MES / MYM)
//
// SECONDS (1s / 5s) micro-event source for the bot's optional "Fast Entry Trigger"
// layer. This script DOES NOT make trade decisions — it only reports tight,
// fast micro events. The webhook app combines them with the EXISTING higher-
// timeframe strict setup and ONLY sharpens entry timing when that HTF setup is
// already valid / nearly-valid AND aligned. The seconds data never creates a
// trade alone and never overrides a bad setup (enforced server-side; both money
// flags default OFF).
//
// Emits these exact alert_type strings (instrument auto-detected, MGC fallback):
//   <PREFIX> SWEEP_RECLAIM_LONG / SWEEP_RECLAIM_SHORT   (micro sweep + reclaim)
//   <PREFIX> DELTA_FLIP_BULLISH / DELTA_FLIP_BEARISH    (signed-volume momentum flip)
//   <PREFIX> MICRO_VWAP_RECLAIM / MICRO_VWAP_LOSS       (price crosses session VWAP)
//   <PREFIX> MICRO_CHOCH_LONG / MICRO_CHOCH_SHORT       (micro structure break)
//   <PREFIX> FAST_SECONDS_BAR                           (optional directionless ref bar)
//
// SETUP:
//   1. Add this script to a SECONDS chart (1s or 5s) for MGC1!, MNQ1!, MES1!, MYM1!.
//   2. Create Alert -> Condition: this indicator -> "Any alert() function call".
//   3. Paste your webhook URL under Notifications -> Webhook URL.
//   4. Leave the message box as-is (the script supplies the JSON). Save.
// ───────────────────────────────────────────────────────────────────────────
indicator("Fast Entry Trigger -> Webhook (MGC/MNQ/MES/MYM)", overlay=true)

// ── Inputs ─────────────────────────────────────────────────────────────────
useAuto      = input.bool(true,  "Auto-detect instrument from symbol")
manualPrefix = input.string("MGC", "Manual instrument (if auto is off)", options=["MGC", "MNQ", "MES", "MYM"])
swLeft       = input.int(6, "Micro swing left bars",  minval=1, tooltip="Bars left that define a micro swing pivot.")
swRight      = input.int(2, "Micro swing right bars", minval=1, tooltip="Bars right that confirm a micro swing pivot.")
deltaLen     = input.int(8, "Delta momentum length",  minval=1, tooltip="EMA length of signed volume for the delta flip.")
chLeft       = input.int(5, "Micro CHOCH left bars",  minval=1)
chRight      = input.int(2, "Micro CHOCH right bars", minval=1)
emitBar      = input.bool(false, "Emit FAST SECONDS BAR reference each bar (noisy)")
showMarks    = input.bool(true,  "Show micro markers on chart")

prefix = useAuto ? (str.contains(syminfo.ticker, "MNQ") ? "MNQ" : str.contains(syminfo.ticker, "MES") ? "MES" : str.contains(syminfo.ticker, "MYM") ? "MYM" : "MGC") : manualPrefix

vwapVal = ta.vwap(hlc3)

// ── Micro swing levels (for sweep + reclaim) ────────────────────────────────
var float swHigh = na
var float swLow  = na
ph = ta.pivothigh(high, swLeft, swRight)
pl = ta.pivotlow(low,  swLeft, swRight)
if not na(ph)
    swHigh := ph
if not na(pl)
    swLow := pl

// Bullish = stop-run BELOW a micro low, bar closes back ABOVE it (reclaim up).
// Bearish = stop-run ABOVE a micro high, bar closes back BELOW it (reclaim down).
bullReclaim = not na(swLow)  and low  < swLow  and close > swLow
bearReclaim = not na(swHigh) and high > swHigh and close < swHigh
var float lastBullLvl = na
var float lastBearLvl = na
bullSweepFire = bullReclaim and (na(lastBullLvl) or swLow  != lastBullLvl)
bearSweepFire = bearReclaim and (na(lastBearLvl) or swHigh != lastBearLvl)
if bullSweepFire
    lastBullLvl := swLow
if bearSweepFire
    lastBearLvl := swHigh

// ── Delta flip (approx signed-volume momentum crossing zero) ─────────────────
sgnVol   = close > open ? volume : close < open ? -volume : 0.0
deltaMom = ta.ema(sgnVol, deltaLen)
deltaBull = ta.crossover(deltaMom,  0)
deltaBear = ta.crossunder(deltaMom, 0)

// ── Micro VWAP reclaim / loss ───────────────────────────────────────────────
vwapReclaim = ta.crossover(close,  vwapVal)
vwapLoss    = ta.crossunder(close, vwapVal)

// ── Micro CHOCH (break of the latest micro structure pivot) ─────────────────
var float chHigh = na
var float chLow  = na
cph = ta.pivothigh(high, chLeft, chRight)
cpl = ta.pivotlow(low,  chLeft, chRight)
if not na(cph)
    chHigh := cph
if not na(cpl)
    chLow := cpl
chochLong  = not na(chHigh) and ta.crossover(close,  chHigh)
chochShort = not na(chLow)  and ta.crossunder(close, chLow)

// ── Webhook payloads (exact alert_type strings the app recognises) ──────────
f_msg(t) => '{"alert_type": "' + prefix + ' ' + t + '", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + '}'

if bullSweepFire
    alert(f_msg("SWEEP_RECLAIM_LONG"),  alert.freq_once_per_bar_close)
if bearSweepFire
    alert(f_msg("SWEEP_RECLAIM_SHORT"), alert.freq_once_per_bar_close)
if deltaBull
    alert(f_msg("DELTA_FLIP_BULLISH"),  alert.freq_once_per_bar_close)
if deltaBear
    alert(f_msg("DELTA_FLIP_BEARISH"),  alert.freq_once_per_bar_close)
if vwapReclaim
    alert(f_msg("MICRO_VWAP_RECLAIM"),  alert.freq_once_per_bar_close)
if vwapLoss
    alert(f_msg("MICRO_VWAP_LOSS"),     alert.freq_once_per_bar_close)
if chochLong
    alert(f_msg("MICRO_CHOCH_LONG"),    alert.freq_once_per_bar_close)
if chochShort
    alert(f_msg("MICRO_CHOCH_SHORT"),   alert.freq_once_per_bar_close)

// Optional directionless reference bar (carries hi / lo / vwap for the snapshot).
barMsg = '{"alert_type": "' + prefix + ' FAST_SECONDS_BAR", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "high": ' + str.tostring(high) + ', "low": ' + str.tostring(low) + ', "vwap": ' + str.tostring(vwapVal) + '}'
if emitBar
    alert(barMsg, alert.freq_once_per_bar_close)

// ── Visuals ─────────────────────────────────────────────────────────────────
plotshape(showMarks and bullSweepFire, title="Sweep+Reclaim Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime,   0), size=size.tiny, text="SR")
plotshape(showMarks and bearSweepFire, title="Sweep+Reclaim Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,    0), size=size.tiny, text="SR")
plotshape(showMarks and chochLong,     title="Micro CHOCH Long",    style=shape.labelup,       location=location.belowbar, color=color.new(color.teal,   0), size=size.tiny, text="CH")
plotshape(showMarks and chochShort,    title="Micro CHOCH Short",   style=shape.labeldown,     location=location.abovebar, color=color.new(color.maroon, 0), size=size.tiny, text="CH")
plot(vwapVal, title="VWAP", color=color.new(color.orange, 0))
