  // ── Module: SCALP Diagnostics (req 7 — DISPLAY-ONLY; SCALP dynamic-exits only) ──
  const sd = d.scalp_diagnostics || {};
  const sdMod = document.getElementById('mod-scalpdiag');
  if (sdMod){
    if (!sd.enabled){
      sdMod.style.display = 'none';
    } else {
      sdMod.style.display = '';
