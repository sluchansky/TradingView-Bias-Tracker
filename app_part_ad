  }

  // ── Module: SWING Diagnostics (P7 / req 6 — DISPLAY-ONLY mirror of the HTF gate + per-trade thesis) ──
  const swd = d.swing_diagnostics || {};
  const swMod = document.getElementById('mod-swingdiag');
