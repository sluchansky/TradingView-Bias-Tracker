    var top=document.createElement('div'); top.className='mbj-score-top';
    top.textContent = cur+' / '+mx+'  (need '+thr+(need>0?(' \u00b7 +'+need+' to READY'):' \u00b7 met')+')';
    scEl.appendChild(top);
