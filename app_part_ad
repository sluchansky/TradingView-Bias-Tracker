      const lc = d.alert_level==='WATCH FOR ENTRY' ? '#3b82f6'
               : d.alert_level==='ARMED' ? '#e67e22' : '#eab308';
      lvlTxt = ' &nbsp;·&nbsp; <b style="color:'+lc+'">'+d.alert_level+'</b>';
    }
