  const aiEl=document.getElementById('ai-ck');
  if (aiEl) aiEl.innerHTML = items.map(function(it){
    return '<div class="ai-item '+(it[1]?'ok':'no')+'"><span class="ic">'+(it[1]?'\u2713':'\u2717')
