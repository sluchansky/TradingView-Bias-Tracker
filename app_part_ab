    base = {"available": False, "reason": "Not enough trade history yet.",
            "win_rate": None, "avg_r": None, "sample": 0, "losing_pattern": None,
            "losing_pattern_n": None, "skip_pattern": None, "best_setup": None,
            "best_window": None, "worst_window": None}
    try:
