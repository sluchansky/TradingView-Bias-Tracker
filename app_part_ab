def compute_entry_quality(result, strict=None, swing_ctx=None):
    """LOCATION-aware entry-quality score (0-100) computed from the FINAL assembled
    result. DISPLAY-ONLY here; the flag-gated veto is wired in full_analysis and can
    only DEMOTE. Direction = the gate's strict_direction (or its forming candidate).
    Every sub-score fails open to a neutral fraction, so missing data yields ~70
    (Acceptable), never a false reject."""
    direction = (result.get("strict_direction")
                 or result.get("gate_candidate")
                 or (strict.get("candidate") if isinstance(strict, dict) else None))
    price = result.get("current_price")
    if direction not in ("Long", "Short") or not price:
        return _entry_quality_neutral_block(
            "No directional candidate — entry location not evaluated.", direction=direction)
    is_long = (direction == "Long")

    vol = result.get("volatility") or {}
    atr = vol.get("atr_pts")
    unit = atr if (isinstance(atr, (int, float)) and atr > 0) else (price * 0.0015)

    # Mode-correct ATR for the EXTENSION metric ONLY (don't measure a session-VWAP
    # distance in 1-minute ATRs for SWING). SCALP: the 1-minute volatility ATR
    # (== unit, so SCALP scoring stays byte-identical). SWING: a higher-timeframe
    # ATR (1H → 4H → Daily) from swing_ctx, NEVER the 1-minute ATR. If no HTF ATR is
    # present in SWING we mark the extension UNAVAILABLE (ext_atr=None) and fail OPEN
    # to the neutral fraction — mixing in the 1m ATR is forbidden, since that is the
    # exact timeframe-mix that produced implausible "13 ATR" readings. The timeframe
    # label is surfaced raw on the dashboard so it can never be silently mixed.
    ext_atr, ext_tf = unit, "1m"
    if TRADING_MODE == "SWING":
        ext_atr, ext_tf = None, "HTF unavailable"
        if isinstance(swing_ctx, dict):
            for _ak, _alabel in (("atr_1h", "1H"), ("atr_4h", "4H"), ("atr_daily", "Daily")):
                _av = swing_ctx.get(_ak)
                if isinstance(_av, (int, float)) and _av > 0:
                    ext_atr, ext_tf = float(_av), _alabel
                    break

    resistance = result.get("nearest_supply")   # level ABOVE price
    support    = result.get("nearest_demand")   # level BELOW price
    vwap       = result.get("vwap_value")

    # Profit-direction ("target") and entry-side ("cushion") levels.
    target_level = resistance if is_long else support
    entry_level  = support    if is_long else resistance

    fracs, details = {}, {}

    # 1) Room to resistance/target — want room to run in the profit direction.
    if target_level and unit:
        room = (target_level - price) if is_long else (price - target_level)
        if room <= 0:
            fracs["room_to_resistance"] = 1.0   # broke past → open road (chasing scored below)
            details["room_to_resistance"] = "clear (price beyond level)"
        else:
            fracs["room_to_resistance"] = _eq_lin(room / unit, 0.3, 2.0)
            details["room_to_resistance"] = "%.2f ATR to target" % (room / unit)
    else:
        fracs["room_to_resistance"] = _EQ_NEUTRAL_FRAC
        details["room_to_resistance"] = "no level"

    # 2) Cushion at support — entering near the trade-side zone = tight risk.
    if entry_level and unit:
        dist = (price - entry_level) if is_long else (entry_level - price)
        if dist < 0:
            fracs["cushion_at_support"] = 0.20   # price beyond the zone (broken)
            details["cushion_at_support"] = "beyond zone"
        else:
            fracs["cushion_at_support"] = 1.0 - (_eq_lin(dist / unit, 0.2, 2.5) or 0.0)
            details["cushion_at_support"] = "%.2f ATR from zone" % (dist / unit)
    else:
        fracs["cushion_at_support"] = _EQ_NEUTRAL_FRAC
        details["cushion_at_support"] = "no zone"

    # 3) Impulse completed — early in the leg = good; late (>~80%) = poor.
    impulse_pct = None
    if entry_level and target_level and target_level != entry_level:
        span = (target_level - entry_level) if is_long else (entry_level - target_level)
        if span:
            prog = ((price - entry_level) / span) if is_long else ((entry_level - price) / span)
            prog = max(0.0, min(1.0, prog))
            impulse_pct = int(round(prog * 100))
            fracs["impulse_completed"] = 1.0 - (_eq_lin(prog, 0.45, 0.95) or 0.0)
            details["impulse_completed"] = "%d%% of leg done" % impulse_pct
        else:
            fracs["impulse_completed"] = _EQ_NEUTRAL_FRAC
            details["impulse_completed"] = "n/a"
    else:
        fracs["impulse_completed"] = _EQ_NEUTRAL_FRAC
        details["impulse_completed"] = "no leg"

    # 4) ATR extension from the mean (VWAP) — far beyond mean in trade dir = stretched.
    #    Uses the MODE-CORRECT ATR (ext_atr / ext_tf): SCALP 1m, SWING 1H/4H/Daily.
    ext = None
    ext_decision = "VWAP unavailable"
    if vwap and ext_atr:
        ext = ((price - vwap) if is_long else (vwap - price)) / ext_atr
        if ext <= 0:
            fracs["atr_extension"] = 1.0   # at/below the mean (for a long) = not extended
            details["atr_extension"] = "%.2f ATR from VWAP (%s)" % (ext, ext_tf)
            ext_decision = "At/below VWAP — not extended"
        else:
            # Graduated ATR-extension scoring (requirement #3): points decay in 1-ATR
            # bands instead of snapping straight to 0 once stretched. Max == the
            # component weight (12), so this stays a 0..1 fraction.
            if ext <= 1.0:
                _eq_ext_pts = 12
            elif ext <= 2.0:
                _eq_ext_pts = 10
            elif ext <= 3.0:
                _eq_ext_pts = 7
            elif ext <= 4.0:
                _eq_ext_pts = 4
            elif ext <= 5.0:
                _eq_ext_pts = 2
            else:
                _eq_ext_pts = 0
            fracs["atr_extension"] = _eq_ext_pts / 12.0
            details["atr_extension"] = "%.2f ATR beyond VWAP (%s)" % (ext, ext_tf)
            if ext <= 1.0:
                ext_decision = "Near VWAP — healthy"
            elif ext <= 2.0:
                ext_decision = "Stretched from VWAP"
            else:
                ext_decision = "Overextended — chasing risk"
    else:
        fracs["atr_extension"] = _EQ_NEUTRAL_FRAC
        if vwap and not ext_atr:
            # VWAP exists but no mode-correct ATR (SWING without HTF ATR): withhold the
            # extension rather than computing it from the wrong timeframe.
            details["atr_extension"] = "HTF ATR unavailable (%s)" % ext_tf
            ext_decision = "HTF ATR unavailable"
        else:
            details["atr_extension"] = "no VWAP"

    # 5) Pullback quality — entering on a controlled retrace (calmer side of VWAP,
    #    near the zone), not at full extension.
    if vwap and entry_level and unit:
        below_mean = (price <= vwap) if is_long else (price >= vwap)
        adist = abs(price - entry_level) / unit
        frac = (0.60 if below_mean else 0.25) + 0.40 * (1.0 - (_eq_lin(adist, 0.2, 2.0) or 0.0))
        fracs["pullback_quality"] = max(0.0, min(1.0, frac))
        details["pullback_quality"] = "retraced toward zone" if below_mean else "above mean"
    else:
        fracs["pullback_quality"] = _EQ_NEUTRAL_FRAC
        details["pullback_quality"] = "insufficient data"

    # 6) Momentum accel/decel — heuristic (alert-driven, limited OHLC): CVD direction
    #    alignment + RVOL + volume confirmation.
    cvd_dir = (result.get("cvd_direction") or "").lower()
    rvol = result.get("rvol_value")
    volume_confirmed = bool(result.get("volume_confirmed"))
    if cvd_dir in ("bullish", "bearish") or isinstance(rvol, (int, float)) or volume_confirmed:
        m = 0.5
        if cvd_dir == ("bullish" if is_long else "bearish"):
            m += 0.25
        elif cvd_dir == ("bearish" if is_long else "bullish"):
            m -= 0.25
        if isinstance(rvol, (int, float)) and rvol >= 1.3:
            m += 0.15
        if volume_confirmed:
            m += 0.10
        fracs["momentum"] = max(0.0, min(1.0, m))
        details["momentum"] = "CVD %s%s%s" % (
            cvd_dir or "?",
            (" · RVOL %.1f" % rvol) if isinstance(rvol, (int, float)) else "",
            " · vol✓" if volume_confirmed else "")
    else:
        fracs["momentum"] = _EQ_NEUTRAL_FRAC
        details["momentum"] = "no order-flow"

    # 7) Liquidity sweep complete — a swept stop run before entry is a PLUS.
    conf = result.get("confluences")
    sweep_present = None
    if isinstance(conf, dict):
        if "liquidity_sweep" in conf:
            sweep_present = bool(conf.get("liquidity_sweep"))
        else:
            for _sub in conf.values():
                if isinstance(_sub, dict) and _sub.get("liquidity_sweep"):
                    sweep_present = True
                    break
    if sweep_present is True:
        fracs["sweep_complete"] = 1.0
        details["sweep_complete"] = "sweep confirmed"
    elif sweep_present is False:
        fracs["sweep_complete"] = 0.55
        details["sweep_complete"] = "no sweep"
    else:
        fracs["sweep_complete"] = _EQ_NEUTRAL_FRAC
        details["sweep_complete"] = "unknown"

    # 8) Not chasing a breakout — price extended beyond the broken level / the mean.
    chasing = False
    if target_level and unit:
        room = (target_level - price) if is_long else (price - target_level)
        if room <= 0 and (abs(price - target_level) / unit) > 0.5:
            chasing = True
    if ext is not None and ext > 2.0:
        chasing = True
    fracs["not_chasing"] = 0.15 if chasing else 1.0
    details["not_chasing"] = "chasing" if chasing else "ok"

    # 9/10) Swing-high/low traps — buying near a swing high (long) or selling near a
    #       swing low (short). The opposite trap is N/A for the active direction (full
    #       marks). Uses swing_ctx extremes when present (SWING), else the nearest zone
    #       as a proxy (SCALP).
    near_high = near_low = False
    highs = (swing_ctx or {}).get("swing_highs") if isinstance(swing_ctx, dict) else None
    lows  = (swing_ctx or {}).get("swing_lows")  if isinstance(swing_ctx, dict) else None
    if is_long:
        ref_high = None
        if highs:
            above = [h for h in highs if h and h >= price]
            ref_high = min(above) if above else None
        if ref_high is None and resistance and resistance >= price:
            ref_high = resistance
        if ref_high and unit and 0 <= (ref_high - price) / unit < 0.4:
            near_high = True
        fracs["not_near_swing_high"] = 0.2 if near_high else 1.0
        fracs["not_near_swing_low"]  = 1.0   # N/A for a long
        details["not_near_swing_high"] = "at swing high" if near_high else "clear"
        details["not_near_swing_low"]  = "n/a (long)"
    else:
        ref_low = None
        if lows:
            below = [l for l in lows if l and l <= price]
            ref_low = max(below) if below else None
        if ref_low is None and support and support <= price:
            ref_low = support
        if ref_low and unit and 0 <= (price - ref_low) / unit < 0.4:
            near_low = True
        fracs["not_near_swing_low"]  = 0.2 if near_low else 1.0
        fracs["not_near_swing_high"] = 1.0   # N/A for a short
        details["not_near_swing_low"]  = "at swing low" if near_low else "clear"
        details["not_near_swing_high"] = "n/a (short)"

    # ── Assemble the 0-100 location score from the weighted sub-scores. ──
    components = []
    total = 0.0
    for key, label, weight in ENTRY_QUALITY_COMPONENTS:
        frac = fracs.get(key)
        if frac is None:
            frac = _EQ_NEUTRAL_FRAC
        pts = weight * frac
        total += pts
        components.append({
            "key": key, "label": label, "max": weight,
            "score": round(pts, 1), "detail": details.get(key, ""),
        })
    score = int(round(max(0.0, min(100.0, total))))
    score_uncapped = score

    # Good room-to-target must NEVER override a BAD location. When a HARD location
    # trap is present (chasing / overextended / impulse nearly done / sitting on a
    # swing extreme), the score can't sit in the Acceptable band on the strength of
    # room or cushion alone — cap it just below the Reject line. Cap DOWN only: it can
    # never raise a score, so it only makes the engine MORE conservative (safe for a
    # demote-only veto). SCALP common path is unaffected (traps already score < 70).
    hard_trap = bool(chasing
                     or (ext is not None and ext > 2.0)
                     or (impulse_pct is not None and impulse_pct >= 90)
                     or near_high or near_low)
    if hard_trap and score >= ENTRY_QUALITY_MIN_SCORE:
        score = ENTRY_QUALITY_MIN_SCORE - 1
    cap_release = max(0, score_uncapped - score)   # points the hard-trap cap removed
    grade = _eq_grade(score)

    edge_score = result.get("edge_score")
    reject = score < ENTRY_QUALITY_MIN_SCORE
    strong_reject = score < ENTRY_QUALITY_STRONG_REJECT
    override_applied = bool(reject and isinstance(edge_score, (int, float))
                           and edge_score >= ENTRY_QUALITY_OVERRIDE_EDGE)
    veto_would_fire = bool(reject and not override_applied)

    # Worst two LOCATION factors → the human "why not enter here" reason.
    worst = sorted(components, key=lambda c: (c["score"] - c["max"]))[:2]
    why = ""
    if reject:
        why = "Poor entry location — " + "; ".join(
            "%s (%s)" % (c["label"].lower(), c["detail"]) for c in worst if c["detail"])
        if override_applied:
            why += " — overridden (Edge %s ≥ %d)." % (edge_score, ENTRY_QUALITY_OVERRIDE_EDGE)

    flags = {
        "chasing_breakout": bool(chasing),
        "near_swing_high":  bool(near_high),
        "near_swing_low":   bool(near_low),
        "sweep_complete":   (bool(sweep_present) if sweep_present is not None else None),
        "overextended":     bool(ext is not None and ext > 2.0),
        "impulse_pct":      impulse_pct,
    }

    # ── What Improves This Trade (requirement #2) — per-condition point deltas + the
    #    score those fixes would project to. The "improvable" components are the
    #    location factors a pullback / fresh confirmation can fix (a deeper pullback
    #    simultaneously eases extension, tightens cushion AND opens room-to-target). A
    #    liquidity SWEEP can also be waited for, so it is improvable too.
    _improvable = ("impulse_completed", "atr_extension", "pullback_quality",
                   "cushion_at_support", "momentum", "room_to_resistance",
                   "sweep_complete", "not_chasing",
                   "not_near_swing_high" if is_long else "not_near_swing_low")
    _imp_labels = {
        "atr_extension":       "Price pulls back closer to VWAP",
        "pullback_quality":    "Controlled pullback into the zone",
        "cushion_at_support":  ("Fresh demand retest (tighter risk)" if is_long
                                else "Fresh supply retest (tighter risk)"),
        "impulse_completed":   "Enter earlier in the leg (wait for a 38–50% pullback)",
        "room_to_resistance":  "Deeper pullback opens room to target",
        "momentum":            ("CVD / order-flow confirms buyers" if is_long
                                else "CVD / order-flow confirms sellers"),
        "sweep_complete":      "Liquidity sweep occurs first",
        "not_chasing":         "Stop chasing — enter on the retrace",
        "not_near_swing_high": "Avoid entering at the swing high",
        "not_near_swing_low":  "Avoid entering at the swing low",
    }
    _eq_weight = {_k: _w for _k, _l, _w in ENTRY_QUALITY_COMPONENTS}
    improvements = []
    for _k in _improvable:
        _f = fracs.get(_k)
        if _f is None or _f >= 0.999:
            continue
        _pts = int(round(_eq_weight.get(_k, 0) * (1.0 - _f)))
        if _pts < 1:
            continue
        improvements.append({"text": _imp_labels.get(_k, _k), "points": _pts})
    improvements.sort(key=lambda it: -it["points"])
    # A HARD location trap caps the displayed score below the Reject line; fixing the
    # trap also releases that penalty, so surface it as its own delta — otherwise the
    # per-condition points wouldn't add up from the (capped) displayed score.
    if cap_release > 0:
        improvements.append({
            "text": "Reset to a fresh pullback / retest (clears the over-extension penalty)",
            "points": cap_release,
        })
    improvement_plan = [it["text"] for it in improvements]

    def _projected(target):
        tot = 0.0
        for _k, _l, _w in ENTRY_QUALITY_COMPONENTS:
            _f = fracs.get(_k)
            if _f is None:
                _f = _EQ_NEUTRAL_FRAC
            if _k in _improvable and _f < target:
                _f = target
            tot += _w * _f
        return int(round(max(0.0, min(100.0, tot))))

    projected_low  = max(score, _projected(0.80))
    projected_high = max(projected_low, _projected(1.0))

    # ── Better Entry Zone (requirement #1) — where a smarter entry sits: a VWAP
    #    pullback, the nearest demand/supply zone, the 50% impulse pullback, or a prior
    #    breakout/retest level. Only references on the PULLBACK side of price count
    #    (below for a long, above for a short). Shown only when the location is poor.
    better_entry_zone = None
    if reject and unit:
        _refs = []
        if isinstance(vwap, (int, float)) and ((vwap < price) if is_long else (vwap > price)):
            _refs.append((vwap, "near VWAP"))
        if entry_level and ((entry_level < price) if is_long else (entry_level > price)):
            _refs.append((entry_level, "demand zone" if is_long else "supply zone"))
            _refs.append(((price + entry_level) / 2.0, "50% impulse pullback"))
        if target_level:
            _broke = (target_level - price) if is_long else (price - target_level)
            if _broke <= 0 and ((target_level < price) if is_long else (target_level > price)):
                _refs.append((target_level, "prior breakout retest"))
        if _refs:
            _lv = [r[0] for r in _refs]
            _lo, _hi = min(_lv), max(_lv)
            if (_hi - _lo) < 1e-9:
                _lo, _hi = _lo - 0.15 * unit, _hi + 0.15 * unit      # single level → ±band
            elif (_hi - _lo) > 1.2 * unit:
                if is_long:
                    _lo = _hi - 1.2 * unit          # keep the shallower (nearer) side
                else:
                    _hi = _lo + 1.2 * unit
            better_entry_zone = {
                "low":     round(min(_lo, _hi), 2),
                "high":    round(max(_lo, _hi), 2),
                "reasons": [r[1] for r in _refs],
            }

    # ── Chasing Warning (requirement #4) — price > 3 ATR beyond VWAP (mode-correct). ─
    chasing_warning = None
    if ext is not None and ext > 3.0:
        chasing_warning = (
            "Price is %.1f ATR beyond VWAP (%s) — far from fair value. Do not enter unless "
            "there is a fresh pullback/retest or strong order-flow confirmation."
            % (ext, ext_tf))

    # ── Entry Plan (requirement #5) — the next actionable step instead of a bare WAIT. ─
    entry_plan = None
    if reject and better_entry_zone:
        _then = [
            ("Bullish" if is_long else "Bearish") + " rejection candle at the zone",
            ("Bullish" if is_long else "Bearish") + " CVD / order-flow confirmation",
        ]
        if entry_level:
            _stop = (("Stop below the demand zone (%.2f)" % entry_level) if is_long
                     else ("Stop above the supply zone (%.2f)" % entry_level))
        else:
            _stop = "Stop below the entry zone" if is_long else "Stop above the entry zone"
        if target_level and (((target_level - price) if is_long else (price - target_level)) > 0):
            _tgt = ("Target back toward %.2f (%s)"
                    % (target_level, "resistance" if is_long else "support"))
        else:
            _tgt = "Target the recent %s / next structure level" % ("high" if is_long else "low")
        entry_plan = {
            "wait_for":     ("Wait for a pullback into %.2f – %.2f"
                             % (better_entry_zone["low"], better_entry_zone["high"])),
            "then_require": _then,
            "stop":         _stop,
            "target":       _tgt,
        }

    raw = {
        "price":            round(price, 2) if isinstance(price, (int, float)) else None,
        "vwap":             round(vwap, 2) if isinstance(vwap, (int, float)) else None,
        "distance_from_vwap": (round(price - vwap, 2)
                               if (isinstance(price, (int, float)) and isinstance(vwap, (int, float)))
                               else None),
        "atr":              round(ext_atr, 4) if isinstance(ext_atr, (int, float)) else None,
        "atr_timeframe":    ext_tf,
        "atr_extension":    (round(abs(price - vwap) / ext_atr, 2) if (vwap and ext_atr) else None),
        "atr_extension_signed": (round(ext, 2) if ext is not None else None),
        "atr_extension_decision": ext_decision,
    }

    # Plain-English explanation: direction can be right while the LOCATION is wrong.
    if reject:
        _bits = []
        if impulse_pct is not None and impulse_pct >= 80:
            _bits.append("the impulse leg is nearly complete")
        if ext is not None and ext > 2.0:
            _bits.append("price is overextended from VWAP")
        elif ext is not None and ext > 1.0:
            _bits.append("price is stretched from VWAP")
        if chasing:
            _bits.append("the entry would be chasing the move")
        if near_high or near_low:
            _bits.append("price is sitting at a swing %s" % ("high" if is_long else "low"))
        _cause = (" " + "; ".join(_bits) + ".") if _bits else ""
        _lead = ("Bad entry location — do not chase." if strong_reject
                 else "The trade idea may be directionally correct, but the entry LOCATION is poor.")
        plain_english = _lead + _cause + " Wait for a pullback or fresh confirmation before entering."
        if override_applied:
            plain_english += (" (Edge %s ≥ %d overrides the location veto.)"
                              % (edge_score, ENTRY_QUALITY_OVERRIDE_EDGE))
    else:
        plain_english = ("Entry location is acceptable (%s) — direction and timing line up and no "
                         "major location traps are present." % (grade or "OK"))

    # ── Verdict label (requirement #6) — a STRONG Edge with a poor LOCATION is "WAIT
    #    FOR BETTER ENTRY", not "NO TRADE": Entry Quality is the execution filter, not
    #    the setup-quality gate. DISPLAY-ONLY (the flag-gated veto wiring is unchanged).
    _edge_strong = isinstance(edge_score, (int, float)) and edge_score >= 70
    if not reject:
        verdict_label, verdict_tier = "OK ENTRY", "ok"
    elif override_applied:
        verdict_label, verdict_tier = "ENTER · EDGE OVERRIDE", "caution"
    elif _edge_strong:
        verdict_label, verdict_tier = "WAIT FOR BETTER ENTRY", "better_entry"
    elif strong_reject:
        verdict_label, verdict_tier = "WAIT · BAD LOCATION", "bad"
    else:
        verdict_label, verdict_tier = "CAUTION · POOR LOCATION", "caution"

    # ── Entry Planner (DISPLAY-ONLY synthesis) ────────────────────────────────
    # Reframes the LOCATION score into an actionable entry PLAN rather than a bare
    # reject: the current problems, a best-entry zone (ideal / acceptable range /
    # aggressive / conservative), what to wait for, and the concrete triggers that
    # would lift Entry Quality into the Good band — with an estimated quality /
    # confidence and a grounded suggested entry / stop / target. PURELY ADDITIVE: it
    # only re-reads values already computed above; it never changes the score, the
    # veto, the verdict, or the money path. Every number is grounded — null (not a
    # fabricated value) whenever it cannot be derived.
    def _eq_px(v):
        return round(v, 2) if isinstance(v, (int, float)) else None

    # 1) CURRENT ENTRY — only EVIDENCE-BACKED problems. A sub-score that merely
    #    failed OPEN on missing data (the neutral 0.70 fallback) is UNKNOWN, not a
    #    problem, so those detail markers are excluded. Ranked by weighted points lost.
    _eq_missing_markers = ("no level", "no zone", "no leg", "n/a", "no vwap",
                           "htf atr unavailable", "insufficient data",
                           "no order-flow", "unknown")
    _eq_problem_label = {
        "room_to_resistance":  "Limited room to target",
        "cushion_at_support":  "Wide risk — far from the trade-side zone",
        "impulse_completed":   "Late in the move — impulse nearly done",
        "atr_extension":       "Overextended from VWAP",
        "pullback_quality":    "Weak pullback into the zone",
        "momentum":            "Order flow not confirming",
        "sweep_complete":      "No liquidity sweep yet",
        "not_chasing":         "Chasing the breakout",
        "not_near_swing_high": "Entering at the swing high",
        "not_near_swing_low":  "Entering at the swing low",
    }
    planner_problems = []
    for _c in components:
        _ck = _c.get("key")
        _cdet = _c.get("detail") or ""
        _lost = (_c.get("max") or 0) - (_c.get("score") or 0)
        if _lost < 3:
            continue
        if any(_m in _cdet.lower() for _m in _eq_missing_markers):
            continue
        _ptxt = _eq_problem_label.get(_ck, _c.get("label") or _ck)
        if _cdet and _ck in ("impulse_completed", "atr_extension",
                             "cushion_at_support", "room_to_resistance"):
            _ptxt = "%s (%s)" % (_ptxt, _cdet)
        planner_problems.append({"text": _ptxt, "lost": int(round(_lost))})
    planner_problems.sort(key=lambda it: -it["lost"])

    # 2) BEST ENTRY ZONE — pullback-side references → ideal / acceptable range /
    #    aggressive (shallowest, nearest current price) / conservative (deepest).
    planner_zone = {"ideal": None, "range_low": None, "range_high": None,
                    "aggressive": None, "conservative": None, "reasons": []}
    _pz_refs = []
    if isinstance(vwap, (int, float)) and ((vwap < price) if is_long else (vwap > price)):
        _pz_refs.append((float(vwap), "VWAP"))
    if entry_level and ((entry_level < price) if is_long else (entry_level > price)):
        _pz_refs.append((float(entry_level), "demand zone" if is_long else "supply zone"))
        _pz_refs.append(((price + float(entry_level)) / 2.0, "50% pullback"))
    if target_level:
        _pz_broke = (target_level - price) if is_long else (price - target_level)
        if _pz_broke <= 0 and ((target_level < price) if is_long else (target_level > price)):
            _pz_refs.append((float(target_level), "breakout retest"))
    if _pz_refs:
        _pz_vals = [r[0] for r in _pz_refs]
        _pz_lo, _pz_hi = min(_pz_vals), max(_pz_vals)
        if is_long:
            _pz_aggr, _pz_cons = _pz_hi, _pz_lo   # shallow pullback = nearer price
        else:
            _pz_aggr, _pz_cons = _pz_lo, _pz_hi
        _pz_ideal = next((rv for rv, rl in _pz_refs if rl == "VWAP"), None)
        if _pz_ideal is None:
            _pz_ideal = (_pz_lo + _pz_hi) / 2.0
        _pz_ideal = max(_pz_lo, min(_pz_hi, _pz_ideal))
        planner_zone = {
            "ideal":        _eq_px(_pz_ideal),
            "range_low":    _eq_px(_pz_lo),
            "range_high":   _eq_px(_pz_hi),
            "aggressive":   _eq_px(_pz_aggr),
            "conservative": _eq_px(_pz_cons),
            "reasons":      [r[1] for r in _pz_refs],
        }

    # 3) WHAT NEEDS TO HAPPEN — forward "wait for" conditions. The ABSENCE of a
    #    confirming factor is legitimate wait-advice (unlike a "problem"), so these
    #    may reference not-yet-confirmed factors.
    _wnh = []
    if ext is not None and ext > 1.0:
        _wnh.append("Wait for a pullback toward VWAP")
    elif (fracs.get("pullback_quality") or 1.0) < 0.7:
        _wnh.append("Wait for a controlled pullback into value")
    if (fracs.get("cushion_at_support") or 1.0) < 0.7:
        _wnh.append("Wait for a fresh %s retest" % ("demand" if is_long else "supply"))
    _wnh.append("Wait for a %s engulfing / rejection candle at the zone"
                % ("bullish" if is_long else "bearish"))
    if sweep_present is not True:
        _wnh.append("Wait for a liquidity sweep")
    if (fracs.get("momentum") or 1.0) < 0.8 or cvd_dir == ("bearish" if is_long else "bullish"):
        _wnh.append("Wait for %s delta / CVD confirmation" % ("bullish" if is_long else "bearish"))
    if not volume_confirmed and not (isinstance(rvol, (int, float)) and rvol >= 1.5):
        _wnh.append("Wait for volume expansion")
    if (impulse_pct is not None and impulse_pct >= 80) or near_high or near_low \
            or (fracs.get("pullback_quality") or 1.0) < 0.7:
        _wnh.append("Wait for a new %s (structure reclaim)"
                    % ("higher low" if is_long else "lower high"))
    _wnh_seen = set()
    what_needs_to_happen = []
    for _w in _wnh:
        if _w not in _wnh_seen:
            _wnh_seen.add(_w)
            what_needs_to_happen.append(_w)

    # 4) ENTRY TRIGGERS — concrete conditions that would lift Entry Quality into the
    #    Good band, plus a grounded suggested entry / stop / target.
    _trigs = []
    if planner_zone["range_low"] is not None and planner_zone["range_high"] is not None:
        if is_long:
            _pb_a = price - planner_zone["range_high"]
            _pb_b = price - planner_zone["range_low"]
        else:
            _pb_a = planner_zone["range_low"] - price
            _pb_b = planner_zone["range_high"] - price
        _pb_lo, _pb_hi = sorted((_pb_a, _pb_b))
        _pb_lo = max(0.0, _pb_lo)
        if _pb_hi > 0:
            if round(_pb_lo) <= 0:
                _trigs.append("Pull back up to %.0f points" % _pb_hi)
            else:
                _trigs.append("Pull back %.0f–%.0f points" % (_pb_lo, _pb_hi))
    if ext is not None and ext > 2.0:
        _trigs.append("Hold ATR extension under 2.0 ATR from VWAP")
    _trigs.append("New %s forms" % ("higher low" if is_long else "lower high"))
    if (ext is not None and ext > 1.0) or (fracs.get("pullback_quality") or 1.0) < 0.7:
        _trigs.append("%s reclaim VWAP" % ("Buyers" if is_long else "Sellers"))
    if (fracs.get("momentum") or 1.0) < 0.8 or cvd_dir == ("bearish" if is_long else "bullish"):
        _trigs.append("%s delta confirmation appears" % ("Bullish" if is_long else "Bearish"))
    if not volume_confirmed and not (isinstance(rvol, (int, float)) and rvol >= 1.5):
        _trigs.append("Volume expansion (RVOL ≥ 1.5)")
    if sweep_present is not True:
        _trigs.append("Liquidity sweep prints")
    _trig_seen = set()
    entry_trigger_conditions = []
    for _t in _trigs:
        if _t not in _trig_seen:
            _trig_seen.add(_t)
            entry_trigger_conditions.append(_t)

    # Estimated quality if the waitable conditions confirm (reuses the projection). Uses
    # the conservative 0.80-"Good band" projection, not the perfect-confirm ceiling, so
    # the estimate is realistic ("if these conditions are met to a Good standard") rather
    # than an optimistic 100.
    _est_quality = projected_low
    # Transparent confidence estimate — a documented BLEND of projected location and
    # the setup Edge, never a true probability (the basis is surfaced). EQ-only when
    # Edge is unavailable.
    if isinstance(edge_score, (int, float)):
        _est_conf = int(round(max(0.0, min(99.0, 0.45 * _est_quality + 0.55 * edge_score))))
        _conf_basis = ("0.45 × projected location (%d) + 0.55 × Edge (%d)"
                       % (_est_quality, int(round(edge_score))))
    else:
        _est_conf = _est_quality
        _conf_basis = "Projected location only (Edge unavailable)"

    # Grounded suggested entry / stop / target. risk_unit = the HTF ATR in SWING (when
    # available) else the base unit, so a SWING stop isn't sized off a 1-minute ATR.
    _risk_unit = ext_atr if (TRADING_MODE == "SWING" and ext_atr) else unit
    _risk_tf = ext_tf if (TRADING_MODE == "SWING" and ext_atr) else "1m"
    _sugg_entry = planner_zone["ideal"]
    _sugg_stop = _sugg_target = _risk_pts = None
    if _sugg_entry is not None and _risk_unit:
        # Anchor the stop one ATR beyond the DEEPEST pullback reference (range bottom for
        # a long, range top for a short) so it always sits past the zone being entered —
        # never off entry_level alone, which can be on the wrong side of the ideal entry
        # (e.g. a demand zone above a VWAP-anchored ideal) and yield negative risk.
        if is_long:
            _stop_anchor = min(_sugg_entry,
                               planner_zone["range_low"] if planner_zone["range_low"] is not None
                               else _sugg_entry)
            _sugg_stop = _eq_px(_stop_anchor - 1.0 * _risk_unit)
        else:
            _stop_anchor = max(_sugg_entry,
                               planner_zone["range_high"] if planner_zone["range_high"] is not None
                               else _sugg_entry)
            _sugg_stop = _eq_px(_stop_anchor + 1.0 * _risk_unit)
        if _sugg_stop is not None:
            _risk_pts = (_sugg_entry - _sugg_stop) if is_long else (_sugg_stop - _sugg_entry)
            if _risk_pts and _risk_pts > 0:
                # Use the structural target only when it yields a sensible 1–4R; an
                # overextended fixture can put resistance 20R away, which is not a
                # realistic single-trade target. Otherwise project a clean 2R.
                _struct_ok = False
                if target_level:
                    _tgt_r = (((target_level - _sugg_entry) if is_long
                               else (_sugg_entry - target_level)) / _risk_pts)
                    _struct_ok = 1.0 <= _tgt_r <= 4.0
                if _struct_ok:
                    _sugg_target = _eq_px(target_level)
                else:
                    _sugg_target = (_eq_px(_sugg_entry + 2.0 * _risk_pts) if is_long
                                    else _eq_px(_sugg_entry - 2.0 * _risk_pts))
            else:
                _sugg_stop = None
                _risk_pts = None

    entry_planner = {
        "available":     True,
        "direction":     direction,
        "current_entry": {
            "score":    score,
            "grade":    grade,
            "problems": planner_problems,
        },
        "best_entry_zone":      planner_zone,
        "what_needs_to_happen": what_needs_to_happen,
        "entry_triggers": {
            "conditions":           entry_trigger_conditions,
            "estimated_quality":    _est_quality,
            "estimated_confidence": _est_conf,
            "confidence_basis":     _conf_basis,
            "suggested_entry":      _sugg_entry,
            "suggested_stop":       _sugg_stop,
            "suggested_target":     _sugg_target,
            "risk_points":          (round(_risk_pts, 2) if isinstance(_risk_pts, (int, float)) else None),
            "risk_basis":           ("%s ATR" % _risk_tf),
            "status":               ("WAIT FOR THESE CONDITIONS" if reject else "ENTRY LOCATION OK"),
        },
    }

    return {
        "engine_enabled":   _entry_quality_engine_enabled(),
        "gate_enabled":     _entry_quality_gate_enabled(),
        "available":        True,
        "direction":        direction,
        "score":            score,
        "grade":            grade,
        "components":       components,
        "flags":            flags,
        "reject":           reject,
        "override_applied": override_applied,
        "veto_would_fire":  veto_would_fire,
        "min_score":        ENTRY_QUALITY_MIN_SCORE,
        "override_edge":    ENTRY_QUALITY_OVERRIDE_EDGE,
        "edge_score":       edge_score,
        "summary":          "Entry Quality %d/100 (%s) — %s" % (score, grade, direction),
        "why_not_trade":    why,
        "strong_reject":    strong_reject,
        "strong_reject_score": ENTRY_QUALITY_STRONG_REJECT,
        "raw":              raw,
        "improvements":     improvements,
        "improvement_plan": improvement_plan,
        "projected_low":    projected_low,
        "projected_high":   projected_high,
        "better_entry_zone": better_entry_zone,
        "chasing_warning":  chasing_warning,
        "entry_plan":       entry_plan,
        "verdict_label":    verdict_label,
        "verdict_tier":     verdict_tier,
        "entry_planner":    entry_planner,
        "plain_english":    plain_english,
        "final_verdict":    None,
    }


