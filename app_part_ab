    tier = entry.get("conviction_tier")
    tier_disp = f"  ·  Tier: **{tier}**" if tier else ""

    # ── Decision-support header (all real-derived; never fabricated) ──────────
    ds = entry.get("decision_support") or _decision_support(entry)
