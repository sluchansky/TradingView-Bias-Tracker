# Windows host configuration template.
# Replace only the placeholder values locally. Never commit the completed .env.

# Safety defaults for first startup
PORT=8000
TRADING_MODE=SCALP
EXECUTION_MODE=disabled
DATABENTO_ENABLED=0
DISCORD_LIVE=0
TRAINING_MODE_ENABLED=1

# Required for the protected dashboard and session signing
DASHBOARD_PASSWORD=<set-a-local-dashboard-password>
SESSION_SECRET=<generate-a-long-random-local-secret>

# Required only when using persistent PostgreSQL-backed state
DATABASE_URL=<postgresql-connection-string>

# Market-data provider
DATABENTO_API_KEY=<set-from-databento>
DATABENTO_MBP1_ENABLED=1
DATABENTO_MGC_SYMBOL=MGC.c.1

# Optional market-data / analysis providers
ALPHA_VANTAGE_API_KEY=<set-from-alpha-vantage>
AI_INTEGRATIONS_OPENAI_API_KEY=<set-from-your-openai-provider>
AI_INTEGRATIONS_OPENAI_BASE_URL=<optional-openai-compatible-base-url>

# Notifications
DISCORD_WEBHOOK_URL=<optional-discord-webhook>
DISCORD_MNQ_WEBHOOK_URL=<optional-discord-mnq-webhook>
DISCORD_JOURNAL_WEBHOOK_URL=<optional-discord-journal-webhook>
DISCORD_APLUS_WEBHOOK_URL=<optional-discord-aplus-webhook>
DISCORD_ALERT_MENTION=@everyone

# Broker/execution integrations. Keep manual_only until deliberately enabled.
TRADERSPOST_WEBHOOK_URL=<optional-traderspost-webhook>
TRADERSPOST_TICKER_MGC=MGC
TRADERSPOST_TICKER_MNQ=MNQ
TRADERSPOST_MAX_CONTRACTS=10
TRADERSPOST_COOLDOWN_SEC=60
EXECUTION_WEBHOOK_URL=<optional-execution-webhook>
EXECUTION_ACCOUNT_ID=<optional-execution-account-id>
EXECUTION_TOKEN=<optional-execution-token>

# Optional feature controls; omitted values use application defaults.
MARKET_HOURS_ENABLED=1
MARKET_ENVIRONMENT_ENABLED=1
VOL_INTELLIGENCE_ENABLED=0
VISUAL_BRAIN_ENABLED=0
VISUAL_BRAIN_BENCHMARK_ENABLED=0
VISUAL_BRAIN_BENCHMARK_CANDIDATE_ENABLED=0
ORDER_FLOW_V1_ENABLED=0
DUAL_TF_ENGINE=0
FVG_ENGINE_ENABLED=0
SWING_HTF_ENABLED=0
SCALP_LIVE_SIM_ENABLED=0
MICRO_SCALP_ENABLED=0
LIVE_RUNNER_ENABLED=0
AUTO_EXIT_ENABLED=0
MANUAL_ORDER_ENABLED=0
LEARNING_GATE_ENABLED=0
LEARNING_SCORE_INFLUENCE=0
ANALYST_ENGINE_ENABLED=0
ANALYST_GATE_ENABLED=0
PRO_REVIEW_ENGINE_ENABLED=0
PRO_REVIEW_GATE_ENABLED=0
TRADE_DEBATE_ENGINE_ENABLED=0
TRADE_DEBATE_GATE_ENABLED=0
ENTRY_QUALITY_ENGINE_ENABLED=0
ENTRY_QUALITY_GATE_ENABLED=0
CANONICAL_MARKET_STATE_ENABLED=0
CANONICAL_MARKET_STATE_SHADOW_ONLY=1
DECISION_PIPELINE_V2_ENABLED=0
GHOST_OBS_COOLDOWN_SECS=300
HEARTBEAT_INTERVAL=300
TRADE_READY_INTERVAL=300
SETUP_BUILDING_INTERVAL=600
AUTO_TRADE_CONTRACTS=1
AUTO_TRADE_MAX_PER_DAY=0
MAX_RISK_DOLLARS=500
MAX_RISK_DOLLARS_PER_TRADE=500